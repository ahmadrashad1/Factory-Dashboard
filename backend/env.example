# Backend Environment Variables
# Copy this file to .env and update values as needed

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/factory_db?schema=public

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=factory-super-secret-token
INFLUXDB_ORG=factory-org
INFLUXDB_BUCKET=sensor-data

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883

# JWT
JWT_SECRET=factory-jwt-super-secret-key-2024
JWT_EXPIRES_IN=24h

